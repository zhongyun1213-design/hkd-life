{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hkd-life",
  "workers_dev": true,
  "preview_urls": false,
  "main": "index.mjs",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hkd-life",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "",
    "NEWS_SITE_ORIGIN": "",
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
